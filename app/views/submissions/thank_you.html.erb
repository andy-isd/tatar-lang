<div class="min-h-screen flex flex-col items-center justify-center text-center px-6">
  <%= image_tag "tatar_ornament.svg", class: "w-24 h-24 mb-8 opacity-60" %>
  <h1 class="text-4xl font-bold uppercase tracking-widest mb-4">Mulțumim!</h1>
  <p class="text-gray-400 text-sm max-w-md mb-8">
    Povestea ta a ajuns la Ismail. Fiecare cuvânt rostit îl ajută să crească
    și să țină vie limba tătară.
  </p>
  <%= link_to "Înapoi acasă", root_path,
        class: "border border-white rounded-full px-8 py-3 text-sm hover:bg-white hover:text-black transition-all" %>
</div>