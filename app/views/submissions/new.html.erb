        </p>
      </div>      
    </div>
  <%else%>
    <%# Ornament / visualizer %>
    <div class="relative flex items-center justify-center my-6">
      <%= image_tag "ornament.png", class: "w-40 h-40 opacity-60" %>      
    </div>
  <% end %>

  <%# Audio file input (upload mode) %>
  <div id="upload-section" class="<%= @story_type == 'citeste' ? 'hidden' : '' %> w-full">
    <%= f.file_field :audio,
          accept: "audio/*,audio/webm,.webm",
          data: {
            submission_recorder_target: "audioUpload",
            action: "change->submission-recorder#uploadChanged"
          },
          class: "hidden" %>
  </div>

  <%# Direct-upload signed id only; disabled when empty so it does not shadow file_field :audio %>
  <input type="hidden"
         name="submission[audio]"
         value=""
         disabled
         data-submission-recorder-target="recordedAudioSignedId">

  <audio controls
         data-submission-recorder-target="audioPreview"
         class="hidden w-full">
  </audio>
  
  

  <%# Controls %>
  <div class="flex flex-col items-center gap-3 w-full">
    <div class="flex items-center gap-3 w-full"
         data-submission-recorder-target="recordControls">
      <button type="button"
              data-action="click->submission-recorder#toggleRecording"
              class="flex-1 flex items-center justify-center gap-3 border border-white rounded-full px-8 py-3 text-sm hover:bg-white hover:text-black transition-all">
              <div
                  data-submission-recorder-target="indicator"
                  class="hidden self-start flex items-end flex-0 justify-center gap-1" style="height: 20px">
                  
                  <span class="eq-bar"></span>
                  <span class="eq-bar"></span>
                  <span class="eq-bar"></span>
                  <span class="eq-bar"></span>
                  <!-- <span class="eq-bar"></span>
                  <span class="eq-bar"></span>
                  <span class="eq-bar"></span> -->
              </div>
        <span data-submission-recorder-target="recordIcon"><i class="lni lni-microphone-1"></i></span>
        <span data-submission-recorder-target="recordLabel">Înregistrează</span>
      </button>

      <button type="button"
              data-action="click->submission-recorder#togglePause"
              data-submission-recorder-target="pauseButton"
              class="hidden flex items-center justify-center gap-2 border border-white rounded-full px-5 py-3 text-sm hover:bg-white hover:text-black transition-all">
        <span data-submission-recorder-target="pauseIcon"><i class="lni lni-pause"></i></span>
        <span data-submission-recorder-target="pauseLabel">Pauză</span>
      </button>
    </div>

    <% if @story_type == "spune" %>
      <button type="button"
              data-action="click->submission-recorder#triggerUpload"
              data-submission-recorder-target="uploadButton"
              class="flex flex-1 items-center justify-center gap-3 border border-white rounded-full px-8 py-3 text-sm hover:bg-white hover:text-black transition-all w-full">
              <i class="lni lni-upload-1"></i> Încarcă fișier
      </button>
      <button type="button"
              data-action="click->submission-recorder#switchToRecording"
              data-submission-recorder-target="switchToRecordButton"
              class="hidden text-sm text-gray-400 hover:text-white underline underline-offset-2">
        Înregistrează în schimb
      </button>
    <% end %>

    <%= f.submit "Trimite",
          data: { submission_recorder_target: "submitButton" },
          class: "hidden w-full border border-white rounded-full px-8 py-3 text-sm cursor-pointer hover:bg-white hover:text-black transition-all" %>
  </div>

  <%# Error messages %>
  <% if @submission.errors.any? %>
    <div class="text-red-400 text-sm text-center">
      <% @submission.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>

<% end %>
</div>