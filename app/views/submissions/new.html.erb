<div class="min-h-screen flex flex-col items-center justify-center px-6 py-16">

<%= link_to  root_path, class: "absolute top-8 left-8 text-2xl text-white hover:opacity-60"  do %>
  <i class="lni lni-arrow-left"></i>
<% end %>

<h1 class="text-4xl font-bold uppercase tracking-widest text-center mb-8">
  <%- if @story_type == "citeste" %>
    <%=image_tag "read_page_title.png", class: "h-16 w-auto" %>
  <%else%>
    <%=image_tag "tell_page_title.png", class: "h-16 w-auto" %>
  <%end%>
</h1>

<p class="text-center max-w-xl text-sm text-gray-400 mb-12">
  <%= @story_type == "citeste" ?
    "Poate ai o poveste amuzantă pe care orice copil și-ar dori să o audă. O amintire de când erai tu copil, o poznă, un moment care ți-a rămas în suflet." :
    "Ai o poveste dragă din copilărie? Spune-i-o lui Ismail. Fiecare poveste îi deschide o lume nouă și îl ajută să crească frumos." %>
</p>

<%= form_with model: @submission,
      class: "flex flex-col items-center gap-6 w-full #{@story_type == 'citeste' ? 'max-w-4xl' : 'max-w-md'}",
      data: { controller: "submission-recorder" } do |f| %>
  <%= f.hidden_field :story_type, value: @story_type %>
  <%= f.hidden_field :input_type,
        value: "recorded",
        data: { submission_recorder_target: "inputType" } %>
  <%= f.hidden_field :duration, data: { submission_recorder_target: "duration" } %>

  <%# Honeypot %>
  <div class="hidden">
    <%= label_tag :website %>
    <%= text_field_tag :website %>
  </div>

  

  <% if @story_type == "citeste" %>
    <div class="w-full">
      <div class="h-[50vh] w-full overflow-y-auto rounded-2xl border border-white/50 bg-transparent p-6 text-sm leading-relaxed text-gray-200">
